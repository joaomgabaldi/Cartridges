using Gtk 4.0;
using Adw 1;

template $SteamPicker: Adw.Dialog {
  content-width: 560;
  content-height: 520;
  title: _("Escolher jogo na Steam");

  Adw.ToolbarView {
    [top]
    Adw.HeaderBar header_bar {}

    [top]
    SearchBar search_bar {
      search-mode-enabled: true;

      Adw.Clamp {
        maximum-size: 450;

        SearchEntry search_entry {
          placeholder-text: _("Buscar jogo…");
          hexpand: true;
        }
      }
    }

    Stack stack {
      transition-type: crossfade;
      vexpand: true;

      StackPage {
        name: "loading";

        child: Adw.Spinner spinner {
          width-request: 32;
          height-request: 32;
          halign: center;
          valign: center;
        };
      }

      StackPage {
        name: "empty";

        child: Adw.StatusPage status_page {
          icon-name: "system-search-symbolic";
          title: _("Nenhum jogo encontrado");
          description: _("Tente buscar por outro nome.");
        };
      }

      StackPage {
        name: "results";

        child: ScrolledWindow {
          hscrollbar-policy: never;

          Adw.Clamp {
            maximum-size: 500;

            ListBox listbox {
              selection-mode: none;
              valign: start;
              margin-top: 12;
              margin-bottom: 12;
              margin-start: 12;
              margin-end: 12;

              styles [
                "boxed-list",
              ]
            }
          }
        };
      }
    }
  }
}
