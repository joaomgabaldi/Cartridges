using Gtk 4.0;
using Adw 1;

template $FitaWizard: Adw.Dialog {
  title: _("Configurar fitas de LED");
  content-width: 480;
  content-height: 520;

  Adw.ToolbarView {
    [top]
    Adw.HeaderBar {}

    Adw.ViewStack stack {
      Adw.ViewStackPage {
        name: "credenciais";

        child: Adw.PreferencesPage {
          Adw.PreferencesGroup {
            title: _("Conta de desenvolvedor da Tuya");
            description: _("As duas chaves saem de uma conta de desenvolvedor da Tuya, em iot.tuya.com, com o app Smart Life vinculado. A Secret é usada agora e não fica salva.");

            header-suffix: LinkButton {
              label: _("Abrir iot.tuya.com");
              uri: "https://iot.tuya.com";
              valign: center;
            };

            Adw.EntryRow api_key_row {
              title: _("API Key");
            }

            Adw.PasswordEntryRow api_secret_row {
              title: _("API Secret");
            }

            Adw.ComboRow regiao_row {
              title: _("Região");

              model: Gtk.StringList {
                strings [
                  "us",
                  "eu",
                  "cn",
                  "in",
                ]
              };
            }
          }

          Adw.PreferencesGroup {
            Box {
              orientation: vertical;
              spacing: 12;

              // Busca que não achou nada volta para cá, e não para a lista de
              // dispositivos: lá o único botão é "Salvar", que gravaria uma
              // lista vazia por cima das fitas já configuradas.
              Label aviso_label {
                visible: false;
                wrap: true;
                justify: center;
                label: _("Nada encontrado. Confira as credenciais e a região.");

                styles [
                  "error",
                ]
              }

              Button buscar_button {
                label: _("Buscar dispositivos");
                halign: center;

                styles [
                  "pill",
                  "suggested-action",
                ]
              }
            }
          }
        };
      }

      Adw.ViewStackPage {
        name: "dispositivos";

        child: Adw.PreferencesPage {
          Adw.PreferencesGroup dispositivos_group {
            title: _("Quais desses são as fitas dos monitores?");
            description: _("Ao salvar, só os marcados ficam na configuração. Desmarcar uma fita a remove.");
          }

          Adw.PreferencesGroup {
            Button salvar_button {
              label: _("Salvar");
              halign: center;

              styles [
                "pill",
                "suggested-action",
              ]
            }
          }
        };
      }

      Adw.ViewStackPage {
        name: "buscando";

        child: Adw.StatusPage {
          title: _("Buscando na sua conta…");

          child: Adw.Spinner {
            width-request: 32;
            height-request: 32;
          };
        };
      }
    }
  }
}
