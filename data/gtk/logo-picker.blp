using Gtk 4.0;
using Adw 1;

template $LogoPicker: Adw.Dialog {
  content-width: 720;
  content-height: 620;
  title: _("Escolher logo");

  Adw.ToolbarView {
    [top]
    Adw.HeaderBar header_bar {
      [end]
      Button title_button {
        label: _("Usar o título");
        tooltip-text: _("Não usar logo neste jogo");
      }
    }

    [top]
    SearchBar search_bar {
      search-mode-enabled: true;

      Adw.Clamp {
        maximum-size: 450;

        SearchEntry search_entry {
          placeholder-text: _("Buscar jogo…");
          hexpand: true;
        }
      }
    }

    Stack stack {
      transition-type: crossfade;
      vexpand: true;

      StackPage {
        name: "loading";

        child: Adw.Spinner spinner {
          width-request: 32;
          height-request: 32;
          halign: center;
          valign: center;
        };
      }

      StackPage {
        name: "empty";

        child: Adw.StatusPage status_page {
          icon-name: "image-x-generic-symbolic";
          title: _("Nenhum logo encontrado");
          description: _("Tente buscar por outro nome");
        };
      }

      StackPage {
        name: "results";

        child: ScrolledWindow {
          hscrollbar-policy: never;

          // One logo per row on a narrow dialog, two side by side once there
          // is room. Wider cells than the cover picker uses, because these are
          // horizontal wordmarks and shrinking them to a portrait grid would
          // make exactly the thing being judged — legibility — impossible to
          // judge.
          FlowBox flowbox {
            homogeneous: true;
            halign: center;
            valign: start;
            column-spacing: 12;
            row-spacing: 12;
            margin-top: 12;
            margin-bottom: 12;
            margin-start: 12;
            margin-end: 12;
            selection-mode: none;
            min-children-per-line: 1;
            max-children-per-line: 2;

            styles [
              "no-hover",
            ]
          }
        };
      }
    }
  }
}
