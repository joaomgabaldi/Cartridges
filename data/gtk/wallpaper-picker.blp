using Gtk 4.0;
using Adw 1;

template $WallpaperPicker: Adw.Dialog {
  content-width: 860;
  content-height: 700;
  title: _("Escolher papel de parede");

  Adw.ToolbarView {
    [top]
    Adw.HeaderBar header_bar {
      [end]
      Button none_button {
        label: _("Não trocar");
        tooltip-text: _("Deixar o papel de parede como está quando este jogo rodar");
      }
    }

    [top]
    SearchBar search_bar {
      search-mode-enabled: true;

      Adw.Clamp {
        maximum-size: 450;

        SearchEntry search_entry {
          placeholder-text: _("Buscar no wallhaven…");
          hexpand: true;
        }
      }
    }

    Stack stack {
      transition-type: crossfade;
      vexpand: true;

      StackPage {
        name: "loading";

        child: Adw.Spinner spinner {
          width-request: 32;
          height-request: 32;
          halign: center;
          valign: center;
        };
      }

      StackPage {
        name: "empty";

        child: Adw.StatusPage status_page {
          icon-name: "image-x-generic-symbolic";
          title: _("Nenhum papel de parede encontrado");
          description: _("Tente buscar por outro nome");
        };
      }

      StackPage {
        name: "results";

        child: ScrolledWindow {
          hscrollbar-policy: never;

          // As celulas ja vem na proporcao do monitor em pe, e o corte que
          // elas mostram e o mesmo que o arquivo final recebe. Quatro por
          // linha numa janela cheia, uma so quando ela encolhe.
          FlowBox flowbox {
            homogeneous: true;
            halign: center;
            valign: start;
            column-spacing: 12;
            row-spacing: 12;
            margin-top: 12;
            margin-bottom: 12;
            margin-start: 12;
            margin-end: 12;
            selection-mode: none;
            min-children-per-line: 1;
            max-children-per-line: 4;

            styles [
              "no-hover",
            ]
          }
        };
      }

      StackPage {
        name: "adjust";

        child: Box {
          orientation: vertical;
          spacing: 12;
          margin-top: 12;
          margin-bottom: 12;
          margin-start: 12;
          margin-end: 12;
          halign: center;
          valign: center;

          Picture adjust_picture {
            content-fit: contain;
            halign: center;
          }

          Label adjust_hint {
            label: _("Arraste para escolher a faixa da imagem");
            halign: center;

            styles [
              "dim-label",
              "caption",
            ]
          }

          Scale adjust_scale {
            hexpand: true;
            draw-value: false;

            adjustment: Adjustment adjust_adjustment {
              lower: 0;
              upper: 100;
              value: 50;
              step-increment: 1;
              page-increment: 10;
            };
          }

          Box {
            spacing: 12;
            halign: center;

            Button adjust_back {
              label: _("Voltar");
            }

            Button adjust_apply {
              label: _("Usar esta imagem");

              styles [
                "suggested-action",
              ]
            }
          }
        };
      }
    }
  }
}
