using Gtk 4.0;
using Adw 1;

template $SgdbPicker: Adw.Dialog {
  content-width: 720;
  content-height: 620;
  title: _("Escolher capa");

  Adw.ToolbarView {
    [top]
    Adw.HeaderBar header_bar {
      [end]
      ToggleButton animated_button {
        label: _("Animadas");
        tooltip-text: _("Mostrar capas animadas");
      }
    }

    [top]
    SearchBar search_bar {
      search-mode-enabled: true;

      Adw.Clamp {
        maximum-size: 450;

        SearchEntry search_entry {
          placeholder-text: _("Buscar jogo…");
          hexpand: true;
        }
      }
    }

    Stack stack {
      transition-type: crossfade;
      vexpand: true;

      StackPage {
        name: "loading";

        child: Adw.Spinner spinner {
          width-request: 32;
          height-request: 32;
          halign: center;
          valign: center;
        };
      }

      StackPage {
        name: "empty";

        child: Adw.StatusPage status_page {
          icon-name: "image-x-generic-symbolic";
          title: _("Nenhuma capa encontrada");
          description: _("Tente buscar por outro nome.");
        };
      }

      StackPage {
        name: "results";

        child: ScrolledWindow {
          hscrollbar-policy: never;

          FlowBox flowbox {
            homogeneous: true;
            halign: center;
            valign: start;
            column-spacing: 12;
            row-spacing: 12;
            margin-top: 12;
            margin-bottom: 12;
            margin-start: 12;
            margin-end: 12;
            selection-mode: none;
            min-children-per-line: 2;
            max-children-per-line: 4;

            styles [
              "no-hover",
            ]
          }
        };
      }
    }
  }
}
