using Gtk 4.0;
using Adw 1;

Adw.StatusPage notice_no_results {
  icon-name: "system-search-symbolic";
  title: _("Nenhum jogo encontrado");
  description: _("Tente outra busca ou outro filtro");
  vexpand: true;
  valign: center;
}

Adw.StatusPage zerados_notice_no_results {
  icon-name: "system-search-symbolic";
  title: _("Nenhum jogo encontrado");
  description: _("Tente outro filtro");
  vexpand: true;
  valign: center;
}

Adw.StatusPage notice_empty {
  title: _("Nenhum jogo");
  description: _("Use o botão + para adicionar jogos");
  vexpand: true;
  valign: center;

  Button {
    label: _("Importar");
    halign: center;
    action-name: "app.import";

    styles [
      "pill",
      "suggested-action",
    ]
  }
}

Adw.StatusPage zerados_notice_empty {
  icon-name: "object-select-symbolic";
  title: _("Nenhum jogo zerado");
  description: _("Jogos desinstalados marcados como Zerado aparecem aqui");
  vexpand: true;
  valign: center;
}

template $CartridgesWindow: Adw.ApplicationWindow {
  title: _("Cartridges");
  width-request: 360;
  height-request: 100;

  // O limiar é o mínimo medido do modo largo da tela de detalhes (835px:
  // capa de 420 + coluna de texto + espaçamentos), com folga. Abaixo disso o
  // modo largo não cabe e a página ganharia rolagem lateral — era 564px, de
  // quando a capa media 280.
  Adw.Breakpoint {
    condition ("max-width: 850px")

    setters {
      details_view_box.orientation: vertical;
      details_view_box.margin-top: 12;
      details_view_box.margin-start: 12;
      details_view_box.margin-end: 12;
      details_view_details_box.margin-start: 0;
      details_view_details_box.margin-end: 0;
      details_view_header.margin-top: 30;
      details_view_logo_clamp.halign: center;
      details_view_title.halign: center;
      details_view_developer.halign: center;
      details_view_publisher.halign: center;
      details_view_release_date.halign: center;
      details_view_rating.halign: center;
      details_view_metacritic.halign: center;
      details_view_steam_review.halign: center;
      details_view_genre.halign: center;
      details_view_controller_support.halign: center;
      details_view_gamepad_recommended.halign: center;
      details_view_description.halign: center;
      details_view_hltb_box.halign: center;
      details_view_date_box.halign: center;
      details_view_status_box.halign: center;
      details_view_cover.width-request: 280;
      details_view_cover.height-request: 420;
      details_view_update_notice.halign: center;
      details_view_toolbar.halign: center;
      details_view_toolbar.orientation: vertical;
      details_view_play_button.halign: center;
      details_view_toolbar_buttons.margin-start: 0;
    }
  }

  Adw.ToastOverlay toast_overlay {
    Overlay session_overlay {
    Adw.NavigationView navigation_view {
      Adw.NavigationPage library_page {
        title: _("Todos os jogos");

        Adw.ToolbarView library_view {
            [top]
            Adw.HeaderBar header_bar {
              [start]
              MenuButton {
                tooltip-text: _("Adicionar jogo");
                icon-name: "list-add-symbolic";
                menu-model: add_games;
              }

              [end]
              MenuButton primary_menu_button {
                tooltip-text: _("Menu principal");
                icon-name: "open-menu-symbolic";
                menu-model: primary_menu;
              }

              // HeaderBar packs [end] children right to left in declaration
              // order, so this sits between the hamburger (declared first, thus
              // furthest right) and the search toggle below it. The icon is
              // wrapped in an Overlay purely to hang the unread dot off its
              // corner; the dot never takes input, the whole button is one
              // target.
              [end]
              Button news_button {
                tooltip-text: _("Novidades");
                action-name: "win.show_news";

                styles [
                  "flat",
                  "image-button",
                ]

                Overlay {
                  Image {
                    icon-name: "novidades-symbolic";
                    // A notch above the 16px symbolic default: the newspaper
                    // carries more internal detail than the lupa and the
                    // hamburger beside it, so at parity it reads as smaller
                    // than it is.
                    pixel-size: 20;
                  }

                  [overlay]
                  Box news_badge {
                    visible: false;
                    can-target: false;
                    halign: end;
                    valign: start;

                    styles [
                      "news-badge",
                    ]
                  }
                }
              }

              [end]
              ToggleButton search_button {
                tooltip-text: _("Buscar");
                icon-name: "system-search-symbolic";
                action-name: "win.toggle_search";
              }
            }

            [top]
            SearchBar search_bar {
              search-mode-enabled: bind search_button.active bidirectional;
              key-capture-widget: navigation_view;

              Adw.Clamp {
                maximum-size: 500;
                tightening-threshold: 500;

                SearchEntry search_entry {
                  placeholder-text: _("Buscar");
                  hexpand: true;

                  ShortcutController {
                    Shortcut {
                      trigger: "Escape";
                      action: "action(win.toggle_search)";
                    }
                  }
                }
              }
            }

            Overlay library_overlay {
              ScrolledWindow scrolledwindow {
                $AnimatedFlowBox library {
                  homogeneous: true;
                  halign: center;
                  valign: start;
                  column-spacing: 12;
                  row-spacing: 12;
                  margin-top: 15;
                  margin-bottom: 15;
                  margin-start: 15;
                  margin-end: 15;
                  selection-mode: none;

                  styles [
                    "no-hover",
                  ]
                }
              }
            }
          }
      }
    }

      [overlay]
      Box session_blocker {
        visible: false;
        halign: fill;
        valign: fill;
        hexpand: true;
        vexpand: true;

        styles [
          "session-blocker",
        ]

        Box {
          orientation: vertical;
          halign: center;
          valign: center;
          hexpand: true;
          vexpand: true;
          spacing: 18;
          margin-start: 24;
          margin-end: 24;

          Label session_blocker_label {
            halign: center;
            wrap: true;
            wrap-mode: word_char;
            natural-wrap-mode: word;
            justify: center;

            styles [
              "title-1",
            ]
          }

          // Só aparece com a mudança de monitor ligada: é lá que a tela fica
          // visível a sessão inteira e o relógio tem para quem contar.
          // "numeric" trava os dígitos na mesma largura, senão o relógio
          // treme a cada segundo.
          Label session_blocker_timer {
            visible: false;
            halign: center;

            styles [
              "title-1",
              "numeric",
            ]
          }

          Button session_blocker_button {
            label: _("Já terminei de jogar");
            halign: center;

            styles [
              "suggested-action",
              "pill",
            ]
          }

          // Plano, e não uma segunda pílula: sair da sessão é o que se faz
          // aqui, anotar é o que se pode fazer. Sem status nenhum de por meio
          // — o jogo desta tela está sendo jogado agora, que é exatamente a
          // pergunta que a anotação responde.
          MenuButton session_blocker_notes_button {
            label: _("Onde eu parei");
            halign: center;
            tooltip-text: _("Anotar onde você parou neste jogo");

            styles [
              "flat",
            ]

            popover: Popover session_blocker_notes_popover {
              Box {
                orientation: vertical;
                width-request: 320;

                ScrolledWindow {
                  height-request: 120;
                  hscrollbar-policy: never;

                  TextView session_blocker_notes_view {
                    top-margin: 4;
                    bottom-margin: 4;
                    left-margin: 4;
                    right-margin: 4;
                    wrap-mode: word_char;
                    accessibility {
                      label: _("Onde eu parei");
                    }
                  }
                }
              }
            };
          }
        }
      }
    }
  }
}

Adw.NavigationPage zerados_library_page {
  title: _("Jogos Zerados");

  Adw.ToolbarView zerados_library_view {
    [top]
    Adw.HeaderBar zerados_header_bar {
      [end]
      MenuButton zerados_primary_menu_button {
        tooltip-text: _("Menu principal");
        icon-name: "open-menu-symbolic";
        menu-model: primary_menu;
      }
    }

    Overlay zerados_library_overlay {
      ScrolledWindow zerados_scrolledwindow {
        $AnimatedFlowBox zerados_library {
          homogeneous: true;
          halign: center;
          valign: start;
          column-spacing: 12;
          row-spacing: 12;
          margin-top: 15;
          margin-bottom: 15;
          margin-start: 15;
          margin-end: 15;
          selection-mode: none;

          styles [
            "no-hover",
          ]
        }
      }
    }

    styles [
      "background",
    ]
  }
}

// Novidades: the readable half of the repack feed. Deliberately built out of
// the same pieces as the rest of the app — a ToolbarView under a HeaderBar, an
// Adw.Clamp keeping the text column readable on a wide window, and a boxed-list
// ListBox of Adw.ActionRows filled from window.py. The three states (loading,
// list, nothing to show) are a Stack rather than juggled visibilities, so only
// one of them can ever be on screen.
Adw.NavigationPage news_page {
  title: _("Novidades");

  Adw.ToolbarView news_view {
    [top]
    Adw.HeaderBar {
      [end]
      Button news_refresh_button {
        tooltip-text: _("Atualizar");
        icon-name: "view-refresh-symbolic";
      }
    }

    Stack news_stack {
      transition-type: crossfade;

      StackPage {
        name: "loading";

        child: Adw.Spinner {
          halign: center;
          valign: center;
          hexpand: true;
          vexpand: true;
          width-request: 32;
          height-request: 32;
        };
      }

      StackPage {
        name: "list";

        child: ScrolledWindow news_scrolledwindow {
          hexpand: true;
          vexpand: true;

          Adw.Clamp {
            maximum-size: 800;
            tightening-threshold: 600;
            margin-top: 18;
            margin-bottom: 18;
            margin-start: 12;
            margin-end: 12;

            ListBox news_list {
              selection-mode: none;
              valign: start;

              styles [
                "boxed-list",
                "news-list",
              ]
            }
          }
        };
      }

      StackPage {
        name: "empty";

        child: Adw.StatusPage news_status {
          icon-name: "novidades-symbolic";
          title: _("Sem novidades");
          description: _("Não foi possível ler o feed.");
          vexpand: true;
          valign: center;

          Button news_retry_button {
            label: _("Tentar novamente");
            halign: center;

            styles [
              "pill",
              "suggested-action",
            ]
          }
        };
      }
    }

    styles [
      "background",
    ]
  }
}

Adw.NavigationPage details_page {
  title: _("Detalhes do jogo");

  Overlay details_view {
    name: "details_view";

    [overlay]
    Adw.ToolbarView details_view_toolbar_view {
      [top]
      Adw.HeaderBar {}

      ScrolledWindow {
        Box details_view_box {
          halign: center;
          valign: center;
          margin-start: 24;
          margin-end: 24;
          margin-top: 24;
          margin-bottom: 24;

          // 420x630, o 2:3 em que as capas são guardadas. Cresceu de 200x300
          // para 280x420 e daí para cá porque a coluna ao lado cresceu junto:
          // gênero, compatibilidade com controle, a recomendação de controle,
          // a sinopse e a anotação chegaram todos depois desses números, e a
          // capa tinha parado de segurar a metade dela da página.
          //
          // Não passa disso: as capas são gravadas em 600x900, então 420x630
          // ainda é uma redução do arquivo. Pedir mais seria esticar o que
          // está guardado, e uma capa borrada é pior que uma capa menor.
          //
          // Na janela estreita ela volta a 280x420 (ver o breakpoint lá em
          // cima): 420 de largura não cabe numa janela de 360.
          //
          // Sharpness is not free here, and the size alone does not buy it:
          // the grid decodes every cover at `shared.display_size` (200x300),
          // which this would stretch 1.4x. What makes it crisp is that the
          // details page decodes its own copy at `shared.details_size` —
          // see `GameCover.add_details_picture`. Changing this number means
          // changing that one.
          //
          // The clamp has to move with the picture. It is the binding
          // constraint: on its own, a larger width-request would be clamped
          // straight back to the old size.
          Adw.Clamp {
            maximum-size: 420;

            Overlay {
              [overlay]
              Adw.Spinner details_view_spinner {
                visible: false;
              }

              Picture details_view_cover {
                halign: end;
                valign: start;
                width-request: 420;
                height-request: 630;

                styles [
                  "card",
                ]
              }
            }
          }

          Box details_view_details_box {
            orientation: vertical;
            margin-start: 48;
            vexpand: true;
            valign: center;

            // Visual header of the content column: the game's official
            // horizontal logo when SteamGridDB has one, otherwise the title
            // exactly as before. Only one of the two is ever visible.
            //
            // The box reserves the header height, but only while a logo is
            // actually being shown — the reservation is applied in code, not
            // here. A fixed one made the title mode pay for a logo that was
            // never coming: the block stayed 72px tall under a one-line title,
            // and the space had to go somewhere.
            //
            // Nothing here constrains the width either. The box takes the
            // column and each child aligns inside it, which is exactly what
            // the title did before it was wrapped in a header, so a title that
            // fit on one line still does.
            //
            // The clamp is the whole sizing story. A Picture asks for its
            // image's own width and only ever grows from there, so a 2000px
            // logo would drag the column open; the clamp is given the width
            // the logo should occupy (computed from its proportions in code)
            // and hands exactly that to the picture, which then derives its
            // own height from it. Height therefore follows width through the
            // image's real aspect ratio instead of being asserted twice, and
            // the picture is free to keep the full-resolution texture it was
            // handed for a sharp result on any display scale.
            Box details_view_header {
              orientation: vertical;
              hexpand: true;
              margin-bottom: 12;

              // vexpand is set in code, together with visibility: it exists to
              // pull the logo down to the bottom of the reserved height, and a
              // hidden child still reports its expand flags to the box, which
              // would leave the title header laying claim to vertical space it
              // has no use for.
              Adw.Clamp details_view_logo_clamp {
                unit: px;
                halign: start;
                valign: end;
                visible: false;

                Picture details_view_logo {
                  content-fit: contain;
                  can-shrink: true;
                }
              }

              // natural-wrap-mode is `none` so the title asks for the width of
              // its text on one line, bounded by max-width-chars. Under `word`
              // it asks only for its longest word, which is what turned
              // "Battlefield 6" into two lines inside a block sized to fit it.
              // Long titles still wrap — that is what the 24-char cap is for.
              Label details_view_title {
                label: _("Título do jogo");
                hexpand: true;
                halign: start;
                valign: end;
                max-width-chars: 24;
                wrap: true;
                wrap-mode: word_char;
                natural-wrap-mode: none;

                styles [
                  "title-1",
                ]
              }
            }

            Label details_view_developer {
              margin-top: 6;
              hexpand: true;
              halign: start;
              max-width-chars: 72;
              wrap: true;
              wrap-mode: word_char;
              natural-wrap-mode: word;

              styles [
                "heading",
              ]
            }

            Label details_view_publisher {
              margin-top: 3;
              hexpand: true;
              halign: start;
              max-width-chars: 72;
              wrap: true;
              wrap-mode: word_char;
              natural-wrap-mode: word;

              styles [
                "dim-label",
              ]
            }

            Label details_view_release_date {
              margin-top: 3;
              hexpand: true;
              halign: start;
              max-width-chars: 72;
              wrap: true;
              wrap-mode: word_char;
              natural-wrap-mode: word;

              styles [
                "dim-label",
              ]
            }

            // A sua nota encabeça a fila das notas: as duas de baixo são de
            // terceiros, e ler a própria antes delas é o que impede a página
            // de virar uma lista de opiniões alheias sobre um jogo que você
            // já jogou. As estrelas são caracteres do texto, e não ícones ao
            // lado: pelo mesmo motivo da recomendação de controle abaixo, um
            // widget separado ganharia alocação própria e quebraria a margem
            // esquerda única do bloco.
            Label details_view_rating {
              visible: false;
              margin-top: 3;
              hexpand: true;
              halign: start;
              xalign: 0;
              max-width-chars: 72;

              styles [
                "dim-label",
              ]
            }

            Label details_view_metacritic {
              margin-top: 3;
              hexpand: true;
              halign: start;
              max-width-chars: 72;
              wrap: true;
              wrap-mode: word_char;
              natural-wrap-mode: word;

              styles [
                "dim-label",
              ]
            }

            Label details_view_steam_review {
              margin-top: 3;
              hexpand: true;
              halign: start;
              max-width-chars: 72;
              wrap: true;
              wrap-mode: word_char;
              natural-wrap-mode: word;

              styles [
                "dim-label",
              ]
            }

            Label details_view_genre {
              margin-top: 3;
              hexpand: true;
              halign: start;
              max-width-chars: 72;
              wrap: true;
              wrap-mode: word_char;
              natural-wrap-mode: word;

              styles [
                "dim-label",
              ]
            }

            Label details_view_controller_support {
              margin-top: 3;
              hexpand: true;
              halign: start;
              max-width-chars: 72;
              wrap: true;
              wrap-mode: word_char;
              natural-wrap-mode: word;

              styles [
                "dim-label",
              ]
            }

            // The star is a character of the sentence rather than an Image
            // beside it. As a separate widget it had its own allocation, so
            // every line of the wrapped paragraph started after it and the
            // block lost its single left edge — GTK has no first-line indent
            // on a Label to undo that. Inline, the star pushes the first line
            // only and the wrap returns to the margin.
            //
            // natural-wrap-mode is `none` so the label asks for the width of
            // the whole sentence on one line, like the title above. It is the
            // widest line of the block and therefore what sets the column's
            // width; max-width-chars is only the ceiling, well above the ~374px
            // the sentence actually measures. Narrowing the window still wraps
            // it, because the minimum request stays the longest word.
            Label details_view_gamepad_recommended {
              visible: false;
              margin-top: 3;
              hexpand: true;
              halign: start;
              xalign: 0;
              max-width-chars: 72;
              wrap: true;
              wrap-mode: word_char;
              natural-wrap-mode: none;
              label: _("★ Os desenvolvedores recomendam jogar este jogo com um controle.");

              styles [
                "dim-label",
              ]
            }

            // O seu recado sobre o jogo, acima do texto da Steam pelo mesmo
            // motivo da nota acima do Metacritic: o que é seu vem antes do que
            // é dos outros. Este é o único bloco da página com um título
            // próprio — os demais são frases que se explicam ("Metacritic:
            // 88"), e um parágrafo solto acima da sinopse não teria como dizer
            // de quem ele é.
            Box details_view_notes_box {
              orientation: vertical;
              margin-top: 18;
              hexpand: true;
              halign: start;
              visible: false;

              Label {
                halign: start;
                xalign: 0;
                label: _("Onde eu parei");

                styles [
                  "caption-heading",
                  "dim-label",
                ]
              }

              // O texto vai como o usuário escreveu, com as quebras de linha
              // que ele pôs: é um bloco de anotações, e uma lista de três
              // coisas vira um parágrafo só se as quebras forem descartadas.
              //
              // Três linhas e reticências: a anotação de uma ou duas linhas,
              // que é a comum, aparece inteira aqui e não custa clique nenhum;
              // a que virou um capítulo vira chamada, e o resto se lê no botão
              // ao lado. Sem o teto, uma anotação longa empurrava a sinopse, o
              // HowLongToBeat e o próprio botão de Jogar para fora da tela.
              Label details_view_notes {
                margin-top: 3;
                hexpand: true;
                halign: start;
                xalign: 0;
                max-width-chars: 72;
                wrap: true;
                wrap-mode: word_char;
                natural-wrap-mode: word;
                lines: 3;
                ellipsize: end;

                styles [
                  "dim-label",
                ]
              }
            }

            // Steam's own pitch, between the facts about the product and how
            // long it takes to finish. The wider top margin is what separates
            // prose from the list of one-line facts above it.
            //
            // natural-wrap-mode stays `word` so this never sets the column's
            // width: it is the only line long enough to do so, and a paragraph
            // deciding how wide the whole page is would stretch every other
            // line with it.
            Label details_view_description {
              visible: false;
              margin-top: 12;
              hexpand: true;
              halign: start;
              xalign: 0;
              max-width-chars: 72;
              wrap: true;
              wrap-mode: word_char;
              natural-wrap-mode: word;

              styles [
                "dim-label",
              ]
            }

            // HowLongToBeat reference block. Deliberately a static table: it
            // never draws a bar, a percentage or any comparison against the
            // user's own playtime — it is a yardstick, not a scoreboard.
            Box details_view_hltb_box {
              orientation: vertical;
              margin-top: 18;
              hexpand: true;
              halign: start;
              visible: false;

              Label {
                label: _("HowLongToBeat");
                halign: start;
                margin-bottom: 6;
                margin-start: 3;

                styles [
                  "caption-heading",
                  "dim-label",
                ]
              }

              Box details_view_hltb_card {
                orientation: horizontal;
                halign: start;

                styles [
                  "card",
                  "hltb-card",
                ]

                Box details_view_hltb_main_cell {
                  orientation: vertical;
                  halign: center;

                  styles [
                    "hltb-cell",
                  ]

                  Label details_view_hltb_main_value {
                    halign: center;

                    styles [
                      "title-4",
                      "numeric",
                    ]
                  }

                  Label {
                    label: _("História");
                    halign: center;
                    margin-top: 2;

                    styles [
                      "caption",
                      "dim-label",
                    ]
                  }
                }

                Separator details_view_hltb_separator_1 {
                  orientation: vertical;
                  margin-top: 10;
                  margin-bottom: 10;
                }

                Box details_view_hltb_extra_cell {
                  orientation: vertical;
                  halign: center;

                  styles [
                    "hltb-cell",
                  ]

                  Label details_view_hltb_extra_value {
                    halign: center;

                    styles [
                      "title-4",
                      "numeric",
                    ]
                  }

                  Label {
                    label: _("Extras");
                    halign: center;
                    margin-top: 2;

                    styles [
                      "caption",
                      "dim-label",
                    ]
                  }
                }

                Separator details_view_hltb_separator_2 {
                  orientation: vertical;
                  margin-top: 10;
                  margin-bottom: 10;
                }

                Box details_view_hltb_completionist_cell {
                  orientation: vertical;
                  halign: center;

                  styles [
                    "hltb-cell",
                  ]

                  Label details_view_hltb_completionist_value {
                    halign: center;

                    styles [
                      "title-4",
                      "numeric",
                    ]
                  }

                  Label {
                    label: _("Completista");
                    halign: center;
                    margin-top: 2;

                    styles [
                      "caption",
                      "dim-label",
                    ]
                  }
                }
              }

              // Per-chapter table, used instead of the card above by the few
              // games HowLongToBeat only catalogues chapter by chapter. Filled
              // from Python (the number of rows is only known at runtime) and
              // deliberately without a total: no such number exists on the
              // site, and "how long is the chapter I'm on" is the real question.
              Box details_view_hltb_chapters {
                orientation: vertical;
                halign: start;
                visible: false;

                styles [
                  "card",
                  "hltb-card",
                  "hltb-chapters",
                ]
              }
            }

            Box details_view_date_box {
              orientation: horizontal;
              margin-top: 15;
              hexpand: true;
              halign: start;

              Label details_view_added {
                wrap: true;
                wrap-mode: word_char;
                natural-wrap-mode: word;
                justify: center;
              }

              Label details_view_last_played {
                margin-start: 12;
                wrap: true;
                wrap-mode: word_char;
                natural-wrap-mode: word;
                justify: center;
              }

              Label details_view_playtime {
                margin-start: 12;
                wrap: true;
                wrap-mode: word_char;
                natural-wrap-mode: word;
                justify: center;
              }

              // Ao lado das datas porque responde à mesma pergunta que elas —
              // vale a pena manter isto instalado? — e não junto dos dados da
              // loja: o tamanho é da sua cópia, não do produto. Fica oculto
              // quando o jogo é aberto por URL de loja, caso em que ninguém
              // aqui sabe onde ele mora.
              Label details_view_size {
                margin-start: 12;
                visible: false;
                wrap: true;
                wrap-mode: word_char;
                natural-wrap-mode: word;
                justify: center;
              }
            }

            // O status logo abaixo das datas, que dizem a mesma coisa que ele:
            // quando o jogo entrou, quando rodou, quanto rendeu. É um controle
            // e não um rótulo porque é o único campo que muda toda vez que se
            // termina um jogo, e mandá-lo para a tela de edição a cada mudança
            // seria três cliques para trocar uma palavra.
            //
            // Sem menu-model: o menu é montado a partir de STATUS_LABELS, como
            // o seletor da tela de edição.
            Box details_view_status_box {
              orientation: horizontal;
              margin-top: 12;
              halign: start;
              spacing: 6;

              MenuButton details_view_status_button {
                tooltip-text: _("Status deste jogo na biblioteca");

                styles [
                  "flat",
                ]
              }

              // Só aparece com o jogo em "Jogando", que é a única situação em
              // que a anotação serve para alguma coisa: um jogo zerado ou na
              // fila não tem onde se parou. O texto continua sendo o mesmo
              // campo da tela de edição — este botão é um atalho para ele, e
              // não um segundo lugar onde escrever.
              MenuButton details_view_notes_button {
                visible: false;
                label: _("Onde eu parei");
                tooltip-text: _("Anotar onde você parou neste jogo");

                styles [
                  "flat",
                ]

                popover: Popover details_view_notes_popover {
                  Box {
                    orientation: vertical;
                    width-request: 320;

                    ScrolledWindow {
                      height-request: 120;
                      hscrollbar-policy: never;

                      TextView details_view_notes_view {
                        top-margin: 4;
                        bottom-margin: 4;
                        left-margin: 4;
                        right-margin: 4;
                        wrap-mode: word_char;
                        accessibility {
                          label: _("Onde eu parei");
                        }
                      }
                    }
                  }
                };
              }
            }

            // Patch-available banner. Sits between the date metadata and the
            // Play toolbar, exactly where the layout mock places it. The whole
            // row is one button so clicking anywhere on it opens the install
            // confirmation; it stays hidden until the checker raises a notice.
            Button details_view_update_notice {
              name: "details_view_update_notice";
              margin-top: 15;
              halign: start;
              visible: false;
              tooltip-text: _("Atualização disponível");

              styles [
                "update-notice",
              ]

              Box {
                spacing: 8;
                halign: center;

                Image {
                  icon-name: "software-update-available-symbolic";
                }

                Label {
                  label: _("Atualização disponível!");

                  styles [
                    "heading",
                  ]
                }
              }
            }

            Box details_view_toolbar {
              hexpand: true;
              vexpand: true;
              valign: center;

              Button details_view_play_button {
                name: "details_view_play_button";
                action-name: "app.launch_game";
                label: _("Jogar");
                halign: start;
                margin-top: 24;

                styles [
                  "opaque",
                  "pill",
                ]
              }

              Box details_view_toolbar_buttons {
                halign: start;
                valign: center;
                margin-top: 24;
                margin-start: 9;

                Button {
                  icon-name: "document-edit-symbolic";
                  action-name: "app.edit_game";
                  tooltip-text: _("Editar");

                  styles [
                    "raised",
                    "circular",
                  ]
                }

                Button details_view_delete_button {
                  icon-name: "user-trash-symbolic";
                  action-name: "win.delete_game";
                  tooltip-text: _("Excluir");
                  visible: false;

                  styles [
                    "raised",
                    "circular",
                  ]
                }

                Button details_view_remove_button {
                  icon-name: "user-trash-symbolic";
                  action-name: "app.remove_game";
                  tooltip-text: _("Remover");

                  styles [
                    "raised",
                    "circular",
                  ]
                }

                MenuButton details_view_search_button {
                  icon-name: "system-search-symbolic";
                  menu-model: search;
                  tooltip-text: _("Buscar");

                  styles [
                    "raised",
                    "circular",
                  ]
                }

                styles [
                  "toolbar",
                ]
              }
            }
          }
        }
      }
    }

    Picture details_view_blurred_cover {
      keep-aspect-ratio: false;
    }
  }
}

menu primary_menu {
  section {
    submenu {
      label: _("Ordenar por");

      item {
        label: _("Jogados recentemente");
        action: "win.sort_by";
        target: "last_played";
      }

      item {
        label: _("Título (A–Z)");
        action: "win.sort_by";
        target: "a-z";
      }

      item {
        label: _("Título (Z–A)");
        action: "win.sort_by";
        target: "z-a";
      }

      item {
        label: _("Lançamento (mais recente)");
        action: "win.sort_by";
        target: "released_newest";
      }

      item {
        label: _("Lançamento (mais antigo)");
        action: "win.sort_by";
        target: "released_oldest";
      }

      item {
        label: _("Adicionados recentemente");
        action: "win.sort_by";
        target: "newest";
      }

      item {
        label: _("Adicionados há mais tempo");
        action: "win.sort_by";
        target: "oldest";
      }

      item {
        label: _("Mais jogados");
        action: "win.sort_by";
        target: "playtime";
      }

      item {
        label: _("Minha nota");
        action: "win.sort_by";
        target: "rating";
      }

      item {
        label: _("Tamanho");
        action: "win.sort_by";
        target: "install_size";
      }
    }

    item {
      label: _("Jogos Zerados");
      action: "win.show_zerados";
      hidden-when: "action-disabled";
    }
  }

  section {
    item (_("Preferências"), "app.preferences")
    item (_("Sobre o Cartridges"), "app.about")
  }
}

menu add_games {
  section {
    item (_("Adicionar jogo"), "app.add_game")
  }

  section {
    item (_("Importar"), "app.import")
  }
}

menu search {
  section {
    label: _("Buscar em…");
    item (_("IGDB"), "app.igdb_search")
    item (_("SteamGridDB"), "app.sgdb_search")
    item (_("PCGamingWiki"), "app.pcgw_search")
    item (_("HowLongToBeat"), "app.hltb_search")
  }
}
