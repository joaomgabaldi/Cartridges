/.venv/
/capturas/

# Gravado so pelo montar_app_qt.py
cartridges/instalacao.json

# QWindowKit: dependencias baixadas e a DLL compilada
/build-aux/windows/qwk/_deps/
/cartridges/janela/*.dll

# Pastas de teste manual (atalhos de mentira)
/_dev/
