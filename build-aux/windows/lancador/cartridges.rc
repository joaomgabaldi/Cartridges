1 ICON "../icon.ico"

/* VERSAO e VERSAO_NUM vêm do montar_app_qt.py. Sem o bloco fixo (FILEVERSION),
   o Windows ignora os textos e o Gerenciador de Tarefas não mostra o nome.
   VERSAO chega sem aspas: a linha de comando do Windows as perde no caminho. */
#define TEXTO_(x) #x
#define TEXTO(x) TEXTO_(x)
1 VERSIONINFO
FILEVERSION VERSAO_NUM
PRODUCTVERSION VERSAO_NUM
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "041604B0"
    BEGIN
      VALUE "CompanyName", "joaomgabaldi"
      VALUE "FileDescription", "Kyron"
      VALUE "FileVersion", TEXTO(VERSAO)
      VALUE "InternalName", "Kyron"
      VALUE "LegalCopyright", "Copyright \251 2026 joaomgabaldi. Licenciado sob a GPL-3.0-or-later."
      VALUE "OriginalFilename", "Kyron.exe"
      VALUE "ProductName", "Kyron"
      VALUE "ProductVersion", TEXTO(VERSAO)
      VALUE "Comments", "Seus jogos em um s\363 lugar"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0416, 1200
  END
END
