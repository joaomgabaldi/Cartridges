#define MyAppName "Cartridges"
#define MyAppVersion "@VERSION@"
#define MyAppPublisher "joaomgabaldi"
#define MyAppURL "https://github.com/joaomgabaldi/Cartridges"
#define MyAppExeName "Cartridges.exe"

[Setup]
AppId={{88FC7AF8-9F74-40EC-AAED-FA6356261CBB}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
AppVerName={#MyAppName} {#MyAppVersion}
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppUpdatesURL={#MyAppURL}
AppCopyright=Copyright © 2026 {#MyAppPublisher}. Licenciado sob a GPL-3.0-or-later.
VersionInfoVersion={#MyAppVersion}
VersionInfoTextVersion={#MyAppVersion}
VersionInfoDescription=Instalador do {#MyAppName}
VersionInfoOriginalFileName=Cartridges Windows.exe
DefaultDirName={autopf64}\Cartridges Revamped
DisableProgramGroupPage=yes
LicenseFile=..\..\..\LICENSE
; Sempre como administrador: o ajuste da NVIDIA grava no driver. A migração de
; uma instalação antiga "só para mim" lê {userprograms}/{userdesktop}.
PrivilegesRequired=admin
UsedUserAreasWarning=no
OutputBaseFilename=Cartridges Windows
SetupIconFile=..\..\..\build-aux\windows\icon.ico
Compression=lzma
SolidCompression=yes
WizardStyle=modern

[Languages]
Name: "brazilianportuguese"; MessagesFile: "compiler:Languages\BrazilianPortuguese.isl"

; Overrides for the messages the wizard actually shows. Two problems with the
; stock translation: it is written informally throughout ("pra" for "para",
; "Aonde" for "Onde"), which clashes with the Portuguese in the app itself; and
; each page has three text slots that it fills with near-identical sentences —
; the licence page said "leia as seguintes informações" and then "leia o
; seguinte Acordo de Licença" directly below it.
;
; The rule applied here: the heading names the page, the subtitle says
; something the body does not, and the body says what to do. Overriding from
; this script rather than editing the .isl in the Inno Setup folder means an
; update to Inno Setup cannot quietly undo any of it.
[Messages]
brazilianportuguese.WelcomeLabel1=Bem-vindo ao instalador do [name]
brazilianportuguese.WelcomeLabel2=O [name/ver] será instalado no seu computador.%n%nRecomendamos fechar os outros aplicativos antes de continuar.

brazilianportuguese.WizardLicense=Acordo de licença
brazilianportuguese.LicenseLabel=O [name] é software livre, distribuído sob a licença GPL-3.0.
brazilianportuguese.LicenseLabel3=Leia o acordo abaixo. É preciso aceitá-lo para continuar.
brazilianportuguese.LicenseAccepted=&Aceito o acordo
brazilianportuguese.LicenseNotAccepted=&Não aceito o acordo

brazilianportuguese.WizardSelectDir=Local de instalação
brazilianportuguese.SelectDirDesc=Onde o [name] deve ser instalado?
brazilianportuguese.SelectDirLabel3=O [name] será instalado na pasta abaixo.
brazilianportuguese.SelectDirBrowseLabel=Clique em Avançar para continuar ou em Procurar para escolher outra pasta.
brazilianportuguese.DiskSpaceGBLabel=São necessários pelo menos [gb] GB livres em disco.
brazilianportuguese.DiskSpaceMBLabel=São necessários pelo menos [mb] MB livres em disco.

brazilianportuguese.WizardSelectTasks=Tarefas adicionais
brazilianportuguese.SelectTasksDesc=O que mais deve ser feito durante a instalação?
brazilianportuguese.SelectTasksLabel2=Marque o que desejar e clique em Avançar.

brazilianportuguese.WizardReady=Pronto para instalar
brazilianportuguese.ReadyLabel1=Tudo pronto para instalar o [name] no seu computador.
brazilianportuguese.ReadyLabel2a=Clique em Instalar para começar ou em Voltar para revisar as opções.
brazilianportuguese.ReadyLabel2b=Clique em Instalar para começar.

brazilianportuguese.WizardInstalling=Instalando
brazilianportuguese.InstallingLabel=Aguarde enquanto o [name] é instalado.

brazilianportuguese.FinishedHeadingLabel=Instalação concluída
brazilianportuguese.FinishedLabel=O [name] foi instalado e já pode ser aberto pelos atalhos criados.
brazilianportuguese.FinishedLabelNoIcons=O [name] foi instalado no seu computador.
brazilianportuguese.ClickFinish=Clique em Concluir para sair.

; Referenced by {cm:...} in [Tasks] and [Run]. A separate section: Inno keeps
; these apart from the wizard's own strings, and putting them above would be
; rejected as unknown message names.
[CustomMessages]
brazilianportuguese.AdditionalIcons=Atalhos:
brazilianportuguese.CreateDesktopIcon=Criar atalho na &área de trabalho
brazilianportuguese.LaunchProgram=Iniciar o %1

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked

[InstallDelete]
; Atualizar por cima deixaria em {app} tudo o que saiu do app entre versoes: o
; modulo removido do repositorio e, na primeira atualizacao depois da 2026.09.22,
; os ~4.000 arquivos do MSYS2 que o instalador levava sem o app usar. As pastas
; saem inteiras e voltam do pacote.
Type: filesandordirs; Name: "{app}\bin"
Type: filesandordirs; Name: "{app}\etc"
Type: filesandordirs; Name: "{app}\lib"
Type: filesandordirs; Name: "{app}\share"

[Files]
; A pasta que o build-installer.ps1 monta com o montar_app.py: so o que o app usa.
Source: "..\..\app\*"; DestDir: "{app}"; Flags: recursesubdirs ignoreversion
Source: "..\..\..\build-aux\windows\icon.ico"; DestDir: "{app}"; Flags: ignoreversion

[Icons]
Name: "{autoprograms}\{#MyAppName}"; Filename: "{app}\bin\{#MyAppExeName}"; IconFilename: "{app}\icon.ico"
Name: "{autodesktop}\{#MyAppName}"; Filename: "{app}\bin\{#MyAppExeName}"; IconFilename: "{app}\icon.ico"; Tasks: desktopicon

[Run]
Filename: "{app}\bin\{#MyAppExeName}"; Description: "{cm:LaunchProgram,{#StringChange(MyAppName, '&', '&&')}}"; Flags: nowait postinstall

[Code]
// Ajuste da NVIDIA. No método de apresentação padrão, o driver Vulkan da NVIDIA
// descarta o alfa da margem da sombra da janela, que aparece como uma moldura
// preta; "Preferir nativo" no perfil do programa resolve. Depois de copiar os
// arquivos, em toda instalação e atualização (interativa ou silenciosa), o
// nvidia-perfil.exe grava esse ajuste no driver pela NVAPI, num perfil
// "Cartridges" só com o Cartridges.exe. Se ele não conseguir (driver ausente ou
// antigo, erro da NVAPI), a instalação interativa mostra o passo a passo manual
// numa página depois da instalação; a silenciosa só registra no log.
const
  DisplayClassKey = 'SYSTEM\CurrentControlSet\Control\Class\{4d36e968-e325-11ce-bfc1-08002be10318}';

var
  NvidiaPage: TOutputMsgWizardPage;
  NvidiaFalhou: Boolean;

// Whether any display adapter Windows knows about is NVIDIA's. Each one has a
// subkey under the display class with the vendor in ProviderName, readable
// without elevation. All of them are checked: the NVIDIA card need not be the
// first, and a virtual display adapter (Parsec, for one) is enough to push it
// down. A card that was swapped out can leave its subkey behind; the utility
// then finds no NVAPI and the manual page shows to someone who has no NVIDIA.
function HasNvidiaGpu: Boolean;
var
  Adapters: TArrayOfString;
  Provider: String;
  I: Integer;
begin
  Result := False;
  if not RegGetSubkeyNames(HKLM, DisplayClassKey, Adapters) then
    Exit;
  for I := 0 to GetArrayLength(Adapters) - 1 do
    if RegQueryStringValue(HKLM, DisplayClassKey + '\' + Adapters[I], 'ProviderName', Provider) then
      if Pos('NVIDIA', Uppercase(Provider)) > 0 then
      begin
        Result := True;
        Exit;
      end;
end;

// Roda o nvidia-perfil.exe escondido e devolve o código de saída (-1 se ele
// nem chegou a rodar). O código e o que ele escreve (a etapa e a mensagem da
// NVAPI, quando falha) vão para o log do instalador. O próprio utilitário
// desiste em 30 s se a NVAPI travar.
function AjustarNvidia(const Acao: String): Integer;
begin
  if not ExecAndLogOutput(ExpandConstant('{app}\bin\nvidia-perfil.exe'),
              Acao + ' "' + ExpandConstant('{app}\bin\{#MyAppExeName}') + '"',
              '', SW_HIDE, ewWaitUntilTerminated, Result, nil) then
    Result := -1;
  Log('nvidia-perfil ' + Acao + ': ' + IntToStr(Result));
end;

procedure InitializeWizard;
begin
  NvidiaPage := CreateOutputMsgPage(wpInstalling,
    'Placa de vídeo NVIDIA',
    'Evita a moldura preta ao redor da janela',
    'Não foi possível configurar a placa de vídeo automaticamente. Para evitar a ' +
    'moldura preta, faça o seguinte ajuste:' + #13#10 + #13#10 +
    '1. Abra o Painel de Controle NVIDIA e acesse Gerenciar as configurações 3D.' + #13#10 +
    '2. Na aba Configurações de programa, adicione o Cartridges.exe da pasta bin da ' +
    'instalação (por padrão, C:\Program Files\Cartridges Revamped\bin).' + #13#10 +
    '3. No método de apresentação Vulkan/OpenGL ("Vulkan/OpenGL present method"), ' +
    'escolha "Preferir nativo" ("Prefer native") e aplique.');
end;

function ShouldSkipPage(PageID: Integer): Boolean;
begin
  Result := (PageID = NvidiaPage.ID) and not NvidiaFalhou;
end;

// Migração de uma instalação antiga "só para mim" (%LOCALAPPDATA%\Programs),
// de quando o instalador ainda oferecia esse modo. O instalador elevado não a
// enxerga e criaria uma segunda cópia. O desinstalador dela não serve: o código
// antigo pergunta se apaga a biblioteca, e numa atualização silenciosa ninguém
// responde. A limpeza é feita aqui, depois de a instalação nova dar certo (se
// ela falhar, a antiga continua de pé), e só no que o instalador antigo criou:
// a pasta pode ter sido escolhida pela pessoa e ter outros arquivos, que ficam.
// A biblioteca e as configurações estão fora da pasta e não são tocadas; o app
// não grava mais nada por usuário que aponte para ela (sem "abrir com o
// Windows"). Os fixados na barra de tarefas que apontavam para o exe antigo
// são corrigidos por CorrigirFixados.
// Limite conhecido: com o UAC respondido por outra conta, o HKCU é o dela e a
// instalação antiga não aparece; fica a cópia duplicada, sem perda de dados.
const
  ChaveDoUsuario = 'Software\Microsoft\Windows\CurrentVersion\Uninstall\{88FC7AF8-9F74-40EC-AAED-FA6356261CBB}_is1';

function Normalizar(const Pasta: String): String;
begin
  Result := AddBackslash(Lowercase(Pasta));
end;

// Apaga o atalho só se ele apontar para dentro da pasta antiga
procedure ApagarAtalhoAntigo(const Atalho, PastaAntiga: String);
var
  Shell, Lnk: Variant;
begin
  if not FileExists(Atalho) then
    Exit;
  Shell := CreateOleObject('WScript.Shell');
  Lnk := Shell.CreateShortcut(Atalho);
  if Pos(PastaAntiga, Lowercase(Lnk.TargetPath)) = 1 then
  begin
    DeleteFile(Atalho);
    Log('Migração: atalho apagado: ' + Atalho);
  end
  else
    Log('Migração: atalho mantido (aponta para outro lugar): ' + Atalho);
end;

// Um item que o instalador antigo criou. True se ele não existe mais.
function ApagarItem(const Caminho: String): Boolean;
begin
  if DirExists(Caminho) then
    Result := DelTree(Caminho, True, True, True)
  else if FileExists(Caminho) then
    Result := DeleteFile(Caminho)
  else
    Result := True;
  if not Result then
    Log('Migração: não foi possível apagar ' + Caminho);
end;

// O que o instalador antigo pôs na pasta ([Files]: o conteúdo de _build\app e o
// icon.ico; o Inno acrescenta o unins000). O unins000.exe sai por último e só se
// todo o resto saiu: enquanto ele existir, a próxima instalação tenta de novo.
function ApagarInstalacaoAntiga(const Pasta: String): Boolean;
begin
  Result := ApagarItem(Pasta + 'bin');
  Result := ApagarItem(Pasta + 'etc') and Result;
  Result := ApagarItem(Pasta + 'lib') and Result;
  Result := ApagarItem(Pasta + 'share') and Result;
  Result := ApagarItem(Pasta + 'icon.ico') and Result;
  Result := ApagarItem(Pasta + 'unins000.dat') and Result;
  if Result then
    Result := ApagarItem(Pasta + 'unins000.exe');
  // Só sai se tiver ficado vazia: o que a pessoa guardou ali fica
  RemoveDir(RemoveBackslash(Pasta));
end;

// Devolve a pasta da instalação antiga (normalizada) quando ela é válida, para
// os fixados na barra de tarefas serem corrigidos; '' quando não há.
function MigrarInstalacaoDoUsuario: String;
var
  Pasta, Dados, Destino: String;
begin
  Result := '';
  if not RegQueryStringValue(HKCU, ChaveDoUsuario, 'InstallLocation', Pasta) then
    Exit;
  Pasta := Normalizar(Pasta);
  Dados := Normalizar(ExpandConstant('{localappdata}\io.github.joaomgabaldi.Cartridges'));
  Destino := Normalizar(ExpandConstant('{app}'));
  Log('Migração: instalação só para o usuário em ' + Pasta);
  if not DirExists(Pasta) or not FileExists(Pasta + 'unins000.exe') then
  begin
    Log('Migração: pasta ausente ou sem unins000.exe; nada apagado');
    Exit;
  end;
  if (Pos(Pasta, Destino) = 1) or (Pos(Destino, Pasta) = 1) or (Pos(Pasta, Dados) = 1) or (Pos(Dados, Pasta) = 1) then
  begin
    Log('Migração: a pasta contém ou está dentro do destino ou dos dados; nada apagado');
    Exit;
  end;
  Result := Pasta;
  try
    ApagarAtalhoAntigo(ExpandConstant('{userprograms}\{#MyAppName}.lnk'), Pasta);
    ApagarAtalhoAntigo(ExpandConstant('{userdesktop}\{#MyAppName}.lnk'), Pasta);
    if ApagarInstalacaoAntiga(Pasta) then
    begin
      RegDeleteKeyIncludingSubkeys(HKCU, ChaveDoUsuario);
      Log('Migração: instalação antiga removida');
    end
    else
      Log('Migração: incompleta; a chave de desinstalação fica para a próxima tentativa');
  except
    Log('Migração interrompida: ' + GetExceptionMessage);
  end;
end;

// Fixados na barra de tarefas do usuário que abrem o app pelo caminho antigo:
// o pythonw.exe desta instalação (de antes do Cartridges.exe) ou o exe da
// instalação "só para mim" que acabou de sair. Passam a abrir o Cartridges.exe,
// e a janela volta a se agrupar com o fixado. Os do menu Iniciar ficam num
// arquivo sem formato documentado e não são tocados.
// O instalador é de 32 bits: nele, o WScript.Shell lê "C:\Program Files" como
// "C:\Program Files (x86)", então as duas formas valem. A regravação usa o
// CreateShellLink do Inno (o mesmo do [Icons]), que grava o caminho certo.
procedure CorrigirFixados(const PastaAntiga: String);
var
  Pasta, Alvo, Pythonw, PythonwX86, Pf64: String;
  Busca: TFindRec;
  Shell, Lnk: Variant;
begin
  Pasta := ExpandConstant('{userappdata}\Microsoft\Internet Explorer\Quick Launch\User Pinned\TaskBar\');
  Pythonw := Lowercase(ExpandConstant('{app}\bin\pythonw.exe'));
  PythonwX86 := Pythonw;
  Pf64 := Normalizar(ExpandConstant('{commonpf64}'));
  if Pos(Pf64, Pythonw) = 1 then
    PythonwX86 := Normalizar(ExpandConstant('{commonpf32}')) + Copy(Pythonw, Length(Pf64) + 1, Length(Pythonw));
  if not FindFirst(Pasta + '*.lnk', Busca) then
    Exit;
  try
    Shell := CreateOleObject('WScript.Shell');
    repeat
      // Um atalho com problema não impede os outros
      try
        Lnk := Shell.CreateShortcut(Pasta + Busca.Name);
        Alvo := Lowercase(Lnk.TargetPath);
        if (Alvo = Pythonw) or (Alvo = PythonwX86) or ((PastaAntiga <> '') and (Pos(PastaAntiga, Alvo) = 1)) then
        begin
          CreateShellLink(Pasta + Busca.Name, '{#MyAppName}', ExpandConstant('{app}\bin\{#MyAppExeName}'),
            '', ExpandConstant('{app}\bin'), ExpandConstant('{app}\icon.ico'), 0, SW_SHOWNORMAL);
          Log('Fixado corrigido: ' + Busca.Name);
        end;
      except
        Log('Fixado ' + Busca.Name + ': ' + GetExceptionMessage);
      end;
    until not FindNext(Busca);
  except
    Log('Fixados: ' + GetExceptionMessage);
  end;
  FindClose(Busca);
end;

procedure CurStepChanged(CurStep: TSetupStep);
var
  Codigo: Integer;
begin
  if CurStep <> ssPostInstall then
    Exit;
  CorrigirFixados(MigrarInstalacaoDoUsuario);
  if HasNvidiaGpu then
  begin
    // 0 funcionou; 3 o exe já está num perfil de outra pessoa ou programa, que
    // fica como está; 4 sem driver ou placa NVIDIA (a chave no registro sobrou
    // de uma placa trocada), sem moldura para evitar; 1 e 2 (e -1, não rodou)
    // pedem o passo a passo manual.
    Codigo := AjustarNvidia('aplicar');
    NvidiaFalhou := (Codigo <> 0) and (Codigo <> 3) and (Codigo <> 4);
    if NvidiaFalhou then
      Log('nvidia: a página com o ajuste manual vai aparecer');
  end;
end;

// Offer to remove the user's library and settings on uninstall. They live
// outside the install folder (LocalAppData + GSettings in the registry), so the
// default uninstall would otherwise leave them behind.
procedure CurUninstallStepChanged(CurUninstallStep: TUninstallStep);
begin
  // Antes de apagar os arquivos, enquanto o utilitário ainda existe: desfaz o
  // perfil "Cartridges" no driver. Uma falha só vai para o log.
  if (CurUninstallStep = usUninstall) and FileExists(ExpandConstant('{app}\bin\nvidia-perfil.exe')) then
    AjustarNvidia('remover');
  if CurUninstallStep = usPostUninstall then
  begin
    // Accented, like every other string here. The compiler reads this file as
    // UTF-8 whether or not it carries a byte order mark — compiling the same
    // script with and without one produces byte-identical installers.
    // A pasta dos saves só sai se for a padrão (dentro de {localappdata}); uma
    // pasta escolhida em Preferências fica onde está, e o texto diz isso.
    if MsgBox('Remover também a biblioteca do Cartridges (lista de jogos, capas, ' +
              'histórico de sessões e os backups dos saves dos jogos guardados na ' +
              'pasta padrão) e as configurações? Os jogos instalados no ' +
              'computador não serão afetados.',
              mbConfirmation, MB_YESNO) = IDYES then
    begin
      // Limite conhecido: numa instalacao para todos os usuarios o desinstalador
      // roda elevado, e se o UAC for respondido com outra conta, {localappdata}
      // e HKCU sao os dessa conta, nao os de quem usa o app.
      DelTree(ExpandConstant('{localappdata}\io.github.joaomgabaldi.Cartridges'), True, True, True);
      RegDeleteKeyIncludingSubkeys(HKEY_CURRENT_USER, 'Software\GSettings\io\github\joaomgabaldi\Cartridges');
      RegDeleteKeyIfEmpty(HKEY_CURRENT_USER, 'Software\GSettings\io\github\joaomgabaldi');
      RegDeleteKeyIfEmpty(HKEY_CURRENT_USER, 'Software\GSettings\io\github');
      RegDeleteKeyIfEmpty(HKEY_CURRENT_USER, 'Software\GSettings\io');
    end;
  end;
end;
