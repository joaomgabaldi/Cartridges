+/*<private>
+ * gdk_win32_surface_anchor_dcomp_hwnd:
+ * @self: a toplevel surface
+ *
+ * Keeps the GL/Vulkan rendering window sitting entirely on top of a monitor.
+ *
+ * That window is a WS_POPUP, so it is positioned in screen coordinates rather
+ * than relative to the toplevel that owns it, and DirectComposition reads it
+ * through the DWM redirection surface — which only covers the part of the
+ * window that overlaps a display. Created at (0, 0) it lands on the primary
+ * monitor, so anything past the primary monitor's bounds is never composed:
+ * a toplevel on a larger secondary monitor renders clipped to the primary's
+ * width and height while staying fully interactive, since input goes to the
+ * toplevel and is unaffected.
+ *
+ * The window is cloaked, so it does not have to follow the toplevel — it only
+ * has to fit on some monitor. Moving it while it still fits would flicker
+ * during a drag across monitors, when the toplevel briefly straddles two of
+ * them, so this only acts once it no longer fits where it is.
+ */
+void
+gdk_win32_surface_anchor_dcomp_hwnd (GdkWin32Surface *self)
+{
+  HMONITOR monitor;
+  MONITORINFO mi;
+  RECT rect;
+
+  if (self->dcomp_hwnd == NULL)
+    return;
+
+  if (!GetWindowRect (self->dcomp_hwnd, &rect))
+    return;
+
+  /* Already covered where it is? Then leave it alone. */
+  monitor = MonitorFromWindow (self->dcomp_hwnd, MONITOR_DEFAULTTONEAREST);
+  mi.cbSize = sizeof (mi);
+
+  if (monitor != NULL &&
+      GetMonitorInfo (monitor, &mi) &&
+      rect.left >= mi.rcMonitor.left &&
+      rect.top >= mi.rcMonitor.top &&
+      rect.right <= mi.rcMonitor.right &&
+      rect.bottom <= mi.rcMonitor.bottom)
+    return;
+
+  /* Otherwise park it on the monitor the toplevel is on. If it is larger than
+   * that monitor there is nothing better to pick, and this is still where it
+   * has to be composed. */
+  monitor = MonitorFromWindow (GDK_SURFACE_HWND (self), MONITOR_DEFAULTTONEAREST);
+  mi.cbSize = sizeof (mi);
+
+  if (monitor == NULL || !GetMonitorInfo (monitor, &mi))
+    return;
+
+  API_CALL (SetWindowPos, (self->dcomp_hwnd,
+                           SWP_NOZORDER_SPECIFIED,
+                           mi.rcMonitor.left,
+                           mi.rcMonitor.top,
+                           0, 0,
+                           SWP_NOACTIVATE | SWP_NOSIZE | SWP_NOCOPYBITS | SWP_NOZORDER));
+}
