diff --git a/gsk/gpu/gskgpurenderpass.c b/gsk/gpu/gskgpurenderpass.c
index d5d8da4..a126b7d 100644
--- a/gsk/gpu/gskgpurenderpass.c
+++ b/gsk/gpu/gskgpurenderpass.c
@@ -474,6 +474,97 @@ extract_scale_from_transform (GskTransform *transform,
     }
 }
 
+/*<private>
+ * unproject_bounds:
+ * @transform: maps the child's coordinates to the parent's
+ * @rect: a rectangle in the parent's coordinates
+ * @out_rect: (out): the bounds of the part of the child's z = 0 plane that
+ *   projects into @rect
+ *
+ * Inverting @transform and transforming @rect with the inverse is only
+ * correct while @transform is affine. With a projective transform each
+ * point of @rect stands for a ray through the child's plane, not for the
+ * point (x, y, 0) that the inverse maps it to, and the bounds come out too
+ * small: content of the child that is visible inside @rect gets clipped
+ * away. That shows when only part of a surface is repainted, which leaves
+ * stale pixels where the clipped content should have been drawn.
+ *
+ * The child is drawn flat at z = 0, so the part of @transform that matters
+ * is the homography from the child's (x, y, 1) to the parent's (x, y, w):
+ * the 4x4 matrix without its z row and z column. Its inverse maps the
+ * corners of @rect back onto the child's plane exactly.
+ *
+ * Returns: %FALSE if a corner of @rect does not map onto the child's plane
+ *   in front of the viewer (@rect crosses the plane's horizon), in which
+ *   case @out_rect is not set
+ */
+static gboolean
+unproject_bounds (GskTransform          *transform,
+                  const graphene_rect_t *rect,
+                  graphene_rect_t       *out_rect)
+{
+  graphene_matrix_t m;
+  graphene_point_t corners[4];
+  graphene_quad_t quad;
+  double a[3][3], inv[3][3], det;
+  int i;
+
+  gsk_transform_to_matrix (transform, &m);
+
+  /* graphene multiplies row vectors: out[j] = sum_i in[i] * m[i][j] */
+  a[0][0] = graphene_matrix_get_value (&m, 0, 0);
+  a[0][1] = graphene_matrix_get_value (&m, 1, 0);
+  a[0][2] = graphene_matrix_get_value (&m, 3, 0);
+  a[1][0] = graphene_matrix_get_value (&m, 0, 1);
+  a[1][1] = graphene_matrix_get_value (&m, 1, 1);
+  a[1][2] = graphene_matrix_get_value (&m, 3, 1);
+  a[2][0] = graphene_matrix_get_value (&m, 0, 3);
+  a[2][1] = graphene_matrix_get_value (&m, 1, 3);
+  a[2][2] = graphene_matrix_get_value (&m, 3, 3);
+
+  inv[0][0] = a[1][1] * a[2][2] - a[1][2] * a[2][1];
+  inv[0][1] = a[0][2] * a[2][1] - a[0][1] * a[2][2];
+  inv[0][2] = a[0][1] * a[1][2] - a[0][2] * a[1][1];
+  inv[1][0] = a[1][2] * a[2][0] - a[1][0] * a[2][2];
+  inv[1][1] = a[0][0] * a[2][2] - a[0][2] * a[2][0];
+  inv[1][2] = a[0][2] * a[1][0] - a[0][0] * a[1][2];
+  inv[2][0] = a[1][0] * a[2][1] - a[1][1] * a[2][0];
+  inv[2][1] = a[0][1] * a[2][0] - a[0][0] * a[2][1];
+  inv[2][2] = a[0][0] * a[1][1] - a[0][1] * a[1][0];
+
+  det = a[0][0] * inv[0][0] + a[0][1] * inv[1][0] + a[0][2] * inv[2][0];
+  if (fabs (det) < 1e-12)
+    return FALSE;
+
+  graphene_rect_get_top_left (rect, &corners[0]);
+  graphene_rect_get_top_right (rect, &corners[1]);
+  graphene_rect_get_bottom_right (rect, &corners[2]);
+  graphene_rect_get_bottom_left (rect, &corners[3]);
+
+  for (i = 0; i < 4; i++)
+    {
+      double x = corners[i].x, y = corners[i].y;
+      double u = (inv[0][0] * x + inv[0][1] * y + inv[0][2]) / det;
+      double v = (inv[1][0] * x + inv[1][1] * y + inv[1][2]) / det;
+      double w = (inv[2][0] * x + inv[2][1] * y + inv[2][2]) / det;
+
+      /* w is 1 / the w that @transform produces at that point of the
+       * plane: not positive means the ray through the corner meets the
+       * plane at or behind the viewer, past its horizon */
+      if (w <= 1e-9)
+        return FALSE;
+
+      corners[i] = GRAPHENE_POINT_INIT (u / w, v / w);
+    }
+
+  /* w is linear in x and y, so with all four corners in front the whole
+   * rectangle is, and its image is the convex quad of the corners */
+  graphene_quad_init (&quad, &corners[0], &corners[1], &corners[2], &corners[3]);
+  graphene_quad_bounds (&quad, out_rect);
+
+  return TRUE;
+}
+
 static gboolean
 gsk_gpu_render_pass_push_transform_check_scale (GskGpuRenderPass                 *self,
                                                 float                             scale_x,
@@ -595,9 +686,33 @@ gsk_gpu_render_pass_push_transform (GskGpuRenderPass                 *self,
               {
                 /* after drawing a clip mask, the clip is either empty or everything is clipped */
                 g_assert (self->clip.type == GSK_GPU_CLIP_NONE);
-                inverse = gsk_transform_invert (gsk_transform_ref (clip_transform));
-                gsk_transform_transform_bounds (inverse, &storage->clip.clip.rect.bounds, &new_bounds);
-                gsk_transform_unref (inverse);
+                if (unproject_bounds (clip_transform, &storage->clip.clip.rect.bounds, &new_bounds))
+                  {
+                    /* Near the plane's horizon the unprojected clip grows far
+                     * past the child. Nothing outside the child is drawn, and
+                     * the clip bounds also feed the offscreen scale heuristics,
+                     * so keep them to the child, as the contained case does.
+                     * An empty result means the child is not visible here. */
+                    if (child_bounds &&
+                        !gsk_rect_intersection (&new_bounds, child_bounds, &new_bounds))
+                      new_bounds = GRAPHENE_RECT_INIT (0, 0, 0, 0);
+                  }
+                else
+                  {
+                    if (child_bounds)
+                      {
+                        /* The clip crosses the plane's horizon: no culling at
+                         * all is always correct, the scissor still limits the
+                         * pixels */
+                        new_bounds = *child_bounds;
+                      }
+                    else
+                      {
+                        inverse = gsk_transform_invert (gsk_transform_ref (clip_transform));
+                        gsk_transform_transform_bounds (inverse, &storage->clip.clip.rect.bounds, &new_bounds);
+                        gsk_transform_unref (inverse);
+                      }
+                  }
                 gsk_gpu_clip_init_empty (&self->clip, graphene_point_zero (), &new_bounds);
               }
           }
