+  /* Cartridges: a entrada é a saída de trás para frente. Num instante t da
+   * entrada, o toast fica como estaria no instante 1 - t da saída: mesma
+   * curva de opacidade e o mesmo leve crescimento, sem subir da borda. */
+  if (info->show_animation || info->hide_animation) {
+    float value;
+
+    if (info->hide_animation) {
+      value = adw_animation_get_value (info->hide_animation) * info->hide_from;
+    } else {
+      float t = adw_animation_get_value (info->show_animation);
+
+      value = 1 - adw_easing_ease (ADW_EASE, 1 - t);
